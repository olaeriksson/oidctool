{
  "name": "oidctool",
  "version": "0.1.0",
  "description": "Cross-platform desktop application for OpenID Connect (OIDC) workflows and testing",
  "main": "src/main/main.js",
  "author": {
    "name": "Ola Eriksson",
    "url": "https://github.com/olaeriksson"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/olaeriksson/oidctool.git"
  },
  "homepage": "https://github.com/olaeriksson/oidctool",
  "license": "MIT",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "electron . --no-sandbox",
    "package:dir": "electron-builder --dir",
    "package:linux": "electron-builder --linux",
    "package:win": "electron-builder --win",
    "package:all": "electron-builder --linux --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.olae.oidctool",
    "productName": "OIDC Tool",
    "copyright": "Copyright © 2026 Ola Eriksson",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "oidctool@olae.io",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "appImage": {
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}